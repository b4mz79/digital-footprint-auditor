# Copy to .env and fill in what you use. Everything is optional except PII_PEPPER_KEY.
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Target (prefilled in the sidebar; the App Password is used server-side only
# and is never sent to the browser)
# ---------------------------------------------------------------------------
GMAIL_TARGET_ADDR=
TARGET_PHONE_NUM=
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Cache security
# ---------------------------------------------------------------------------
# REQUIRED. HMAC secret for cache file names, at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_PEPPER_KEY=
# Optional Fernet key for the encrypted cache. If empty, a key file is created (see below).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CACHE_SECRET_KEY=
# Key file used when CACHE_SECRET_KEY is empty. Relative paths are anchored to the project
# folder, not to the directory you start the app from.
CACHE_KEY_FILE=.cache_key
AI_CACHE_DIR=cache
BREACH_CACHE_DIR=cache/breach
# Cache files older than this are deleted at startup (the cache itself expires after 12h).
CACHE_RETENTION_HOURS=24
# Separate caches when several people share one install.
TENANT_ID=default

# ---------------------------------------------------------------------------
# AI providers (only sanitized service names/evidence are sent - never your email or phone)
# ---------------------------------------------------------------------------
# Order in which providers are tried. Ollama is the final local fallback by default.
LLM_PROVIDER_ORDER=gemini,groq,openai,ollama
# true = never call a cloud provider, use the local Ollama model only.
LLM_LOCAL_ONLY=false
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq lists qwen/qwen3.8-27b as a *preview* model (may be withdrawn); an alternative from Groq's
# production list is e.g. openai/gpt-oss-20b.
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ALLOW_REMOTE=false
OLLAMA_TRUST_ENV=false
OLLAMA_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=120
AI_CONCURRENCY=4
MAX_LLM_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Breach / OSINT engines
# ---------------------------------------------------------------------------
RAPIDAPI_KEY=
TAVILY_API_KEY=
# Google Custom Search JSON API is closed to new customers and is scheduled to shut down on
# 2027-01-01. Leave these empty after that date; the engine is then reported as "skipped".
GOOGLE_SEARCH_API_KEY=
GOOGLE_CX_ID=
SEARXNG_INSTANCE_URL=
# Seconds to wait between targets (email, then each phone variant).
DELAY_SECONDS=2
HTTPX_TRUST_ENV=false
IGNORED_DOMAINS_FILE=ignored_domains.txt

# Phone search variants: default region for numbers written without "+", and how many
# variants are searched (each variant is sent to every engine).
DEFAULT_PHONE_REGION=ID
PHONE_VARIANTS_MAX=3

# ---------------------------------------------------------------------------
# IMAP
# ---------------------------------------------------------------------------
# Newest matching messages inspected (max 2000). Older registrations are missed beyond this.
IMAP_MAX_EMAILS=200

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
EXPOSE_CACHE_PATH=false

# ===============================
# Breach Scanner v2
# ===============================
# Maximum concurrent workers
BREACH_QUEUE_WORKERS=4
# Seconds before retrying unhealthy engine
BREACH_ENGINE_COOLDOWN=60
# HTTP retry policy
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_SECONDS=1.5
# HTTP concurrency
HTTP_MAX_CONCURRENCY=4
HIBP_API_KEY=
HIBP_USER_AGENT=Digital Footprint Auditor
# Optional Evidence Enrichment (security-publication context; domain-only queries)
FIRECRAWL_API_KEY=
